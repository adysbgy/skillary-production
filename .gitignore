# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next*/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/settings.local.json
.claude/settings.local.json.backup*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit the template only
.env*
!.env.example

# local database
*.db
*.db-journal

# local uploads are ephemeral development data
/public/uploads/

# scratch and generated preview/test artifacts
/scratch/
/.homepage-preview-test-build/
/.navigation-test-build/
/.preview-learning.html
/.route-response.html

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated integrity policy test build
.integrity-test-build/
