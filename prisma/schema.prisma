datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("LEARNER")
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  enrollments       Enrollment[]
  pathEnrollments   PathEnrollment[]
  lessonProgress    LessonProgress[]
  certificates      Certificate[]
  courses           Course[]           @relation("CourseInstructor")
  paymentOrders     PaymentOrder[]
  quizAttempts      QuizAttempt[]
  batchParticipants BatchParticipant[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id                      String               @id @default(cuid())
  slug                    String               @unique
  title                   String
  description             String
  level                   String
  duration                String
  category                String
  price                   Float                @default(0)
  status                  String               @default("DRAFT")
  thumbnailUrl            String?
  certificateMode         String               @default("INCLUDED") // "INCLUDED" | "PAID_DIGITAL" | "DISABLED"
  digitalCertificatePrice Int? // Price in IDR for PAID_DIGITAL mode, null otherwise
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  instructorId            String?
  instructor              User?                @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules                 Module[]
  enrollments             Enrollment[]
  certificates            Certificate[]
  paymentOrders           PaymentOrder[]
  outcomesData            String?
  audienceData            String?
  prerequisitesData       String?
  learningPaths           LearningPathCourse[]
  batchCourses            BatchCourse[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id           String           @id @default(cuid())
  moduleId     String
  title        String
  slug         String
  type         String           @default("TEXT")
  content      String           @default("")
  videoUrl     String?
  quizData     String?
  sortOrder    Int              @default(0)
  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]
  resources    Resource[]
}

model Resource {
  id        String   @id @default(cuid())
  lessonId  String
  filename  String
  url       String
  fileType  String
  fileSize  Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Enrollment {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  source           String    @default("UNKNOWN") // "FREE" | "PAID" | "MANUAL" | "UNKNOWN"
  grantedByAdminId String?
  revokedAt        DateTime?
  revokedByAdminId String?
  enrolledAt       DateTime  @default(now())
  completedAt      DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model PathEnrollment {
  id             String       @id @default(cuid())
  userId         String
  learningPathId String
  enrolledAt     DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@index([userId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Certificate {
  id         String   @id @default(cuid())
  uniqueCode String   @unique @default(cuid())
  userId     String
  courseId   String? // null for event-based certificates
  eventSlug  String? // null for course-based certificates; set for webinar attendance certs
  eventTitle String? // snapshot, since events are static data, not a DB relation
  issuedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@unique([userId, eventSlug])
}

model PaymentOrder {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  productType String   @default("COURSE") // "COURSE" | "DIGITAL_CERTIFICATE"
  amount      Float
  status      String   @default("PENDING")
  gatewayRef  String?
  gatewayData String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId])
}

// Guest-native ticket order for paid webinars/events (B2C funnel from ads).
// No User/Course FK required — cold traffic buys with just name/email/WA and
// receives access (Zoom link, recording, e-certificate) at those contacts.
model EventOrder {
  id            String    @id @default(cuid())
  eventSlug     String
  eventTitle    String
  amount        Float
  status        String    @default("PENDING") // PENDING | PAID | FAILED | EXPIRED
  name          String
  email         String
  whatsapp      String
  userId        String? // linked to the passwordless auto-account on fulfillment
  fulfilledAt   DateTime? // set once access is granted + buyer notified
  joinUrl       String? // unique Zoom registrant join link for this buyer
  attendedAt    DateTime? // set once Zoom attendance meets the certificate threshold
  remindersSent String[]  @default([]) // reminder tags already sent (e.g. "H-1")
  gatewayRef    String? // Midtrans Snap token / transaction id
  gatewayData   String? // raw gateway payload (JSON)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([email])
  @@index([eventSlug])
  @@index([userId])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  lessonId       String
  score          Int
  totalQuestions Int
  passed         Boolean  @default(false)
  answers        String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // ROLE_CHANGE, COURSE_REASSIGN, PUBLISH_CHANGE
  actorId   String
  targetId  String?
  meta      String? // JSON string for extra context
  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
}

model LearningPath {
  id           String               @id @default(cuid())
  title        String
  slug         String               @unique
  description  String
  status       String               @default("DRAFT")
  mode         String               @default("GUIDED") // "GUIDED" | "SEQUENTIAL"
  thumbnailUrl String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  courses      LearningPathCourse[]
  enrollments  PathEnrollment[]
}

model LearningPathCourse {
  id             String       @id @default(cuid())
  learningPathId String
  courseId       String
  sortOrder      Int          @default(0)
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, courseId])
  @@index([learningPathId])
  @@index([courseId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Lead {
  id              String    @id @default(cuid())
  name            String
  email           String
  whatsapp        String?
  organization    String?
  role            String?
  inquiryType     String
  programInterest String?
  sourcePage      String?
  message         String
  status          String    @default("NEW")
  notes           String?
  archivedAt      DateTime?
  lastContactedAt DateTime?
  proposalSentAt  DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  sector          String?
  contactName     String?
  contactEmail    String?
  contactWhatsapp String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batches TrainingBatch[]

  @@index([name])
}

model TrainingBatch {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  description    String?
  format         String    @default("ONLINE")
  status         String    @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants BatchParticipant[]
  courses      BatchCourse[]

  @@index([organizationId])
  @@index([status])
  @@index([startDate])
}

model BatchParticipant {
  id        String    @id @default(cuid())
  batchId   String
  userId    String?
  name      String
  email     String
  whatsapp  String?
  role      String?
  status    String    @default("INVITED")
  notes     String?
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  batch TrainingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([batchId, email])
  @@index([batchId])
  @@index([email])
  @@index([userId])
}

model BatchCourse {
  id        String   @id @default(cuid())
  batchId   String
  courseId  String
  required  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  batch  TrainingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([batchId, courseId])
  @@index([batchId])
  @@index([courseId])
}

model TrainerProfile {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  status           String                   @default("DRAFT_RESEARCH")
  verification     String                   @default("SELECTED")
  name             String
  email            String
  linkedinUrl      String?
  websiteUrl       String?
  headline         String                   @default("")
  shortBio         String                   @default("")
  fullBio          String                   @default("")
  portraitUrl      String?
  actionPhotoUrl   String?
  photoRights      String?
  location         String?
  languages        String[]                 @default([])
  deliveryModes    String[]                 @default([])
  expertise        String[]                 @default([])
  audiences        String[]                 @default([])
  outcomes         String[]                 @default([])
  teachingApproach Json?
  experience       Json?
  credentials      Json?
  programs         Json?
  evidence         Json?
  metrics          Json?
  consentedAt      DateTime?
  verifiedAt       DateTime?
  publishedAt      DateTime?
  reviewDueAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  sources          TrainerSource[]
  claims           TrainerClaim[]
  reviewTokens     TrainerReviewToken[]
  auditEvents      TrainerAuditEvent[]
  offerAssignments OfferTrainerAssignment[]

  @@index([status])
  @@index([verification])
}

model TrainerSource {
  id        String         @id @default(cuid())
  trainerId String
  url       String
  title     String?
  type      String         @default("PUBLIC_WEB")
  notes     String?
  checkedAt DateTime?
  createdAt DateTime       @default(now())
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model TrainerClaim {
  id         String         @id @default(cuid())
  trainerId  String
  field      String
  value      String
  status     String         @default("UNVERIFIED")
  sourceId   String?
  notes      String?
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  trainer    TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, status])
}

model TrainerReviewToken {
  id        String         @id @default(cuid())
  trainerId String
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model TrainerAuditEvent {
  id        String         @id @default(cuid())
  trainerId String
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime       @default(now())
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, createdAt])
}

// Canonical public and commercial identity for every Skillary offer. Existing
// Course, LearningPath, TrainingBatch, and payment models remain runtime systems
// and are connected additively through OfferRuntimeMapping.
model CommercialOffer {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  type                 String
  audience             String
  status               String    @default("DRAFT")
  title                String
  summary              String
  description          String?
  primaryAction        String    @default("REGISTER_INTEREST")
  currency             String    @default("IDR")
  priceAmount          Int?
  capacity             Int?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  publishedAt          DateTime?
  archivedAt           DateTime?
  reviewedAt           DateTime?
  ownerId              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  runtimeMappings    OfferRuntimeMapping[]
  trainerAssignments OfferTrainerAssignment[]
  productionRecords  ProgramProduction[]
  evidenceLinks      OfferEvidenceLink[]
  auditEvents        OfferAuditEvent[]

  @@index([type, status])
  @@index([audience, status])
  @@index([publishedAt])
}

// Compatibility bridge from a commercial offer to current runtime records.
// runtimeType/runtimeId validity is enforced by the repository service because
// Prisma does not support polymorphic foreign keys.
model OfferRuntimeMapping {
  id          String   @id @default(cuid())
  offerId     String
  runtimeType String
  runtimeId   String
  purpose     String   @default("PRIMARY")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  offer CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([offerId, runtimeType, runtimeId])
  @@index([runtimeType, runtimeId])
}

// A published trainer profile proves identity readiness only. This relation
// records the trainer's explicit role and acceptance for a particular offer.
model OfferTrainerAssignment {
  id                String    @id @default(cuid())
  offerId           String
  trainerProfileId  String
  role              String
  status            String    @default("PROPOSED")
  scope             Json?
  compensationType  String?
  compensationTerms Json?
  acceptedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  offer   CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  trainer TrainerProfile  @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)

  @@unique([offerId, trainerProfileId, role])
  @@index([trainerProfileId, status])
  @@index([offerId, status])
}

// Versioned production workflow for trainer-authored programs. Public readiness
// requires an approved production record and every required item to be approved.
model ProgramProduction {
  id               String    @id @default(cuid())
  offerId          String
  stage            String    @default("TOPIC_PROPOSAL")
  ownerTrainerId   String?
  reviewerId       String?
  version          Int       @default(1)
  reviewNotes      String?
  pilotAt          DateTime?
  approvedAt       DateTime?
  maintenanceDueAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  offer CommercialOffer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  items ProgramProductionItem[]

  @@unique([offerId, version])
  @@index([stage])
  @@index([maintenanceDueAt])
}

model ProgramProductionItem {
  id            String    @id @default(cuid())
  productionId  String
  requirement   String
  status        String    @default("MISSING")
  assetUrl      String?
  notes         String?
  completedById String?
  completedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  production ProgramProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@unique([productionId, requirement])
  @@index([status])
}

// All public testimonials, metrics, logos, partner statements, and event results
// are fail-closed until approval and consent are present and valid.
model EvidenceRecord {
  id              String    @id @default(cuid())
  type            String
  status          String    @default("DRAFT")
  sourceReference String
  approvedCopy    String?
  subjectName     String?
  consentStatus   String    @default("PENDING")
  consentProofUrl String?
  ownerId         String?
  approvedAt      DateTime?
  expiresAt       DateTime?
  withdrawnAt     DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  offerLinks OfferEvidenceLink[]

  @@index([type, status])
  @@index([expiresAt])
}

model OfferEvidenceLink {
  id         String   @id @default(cuid())
  offerId    String
  evidenceId String
  placement  String
  createdAt  DateTime @default(now())

  offer    CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  evidence EvidenceRecord  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([offerId, evidenceId, placement])
  @@index([evidenceId])
}

model OfferAuditEvent {
  id        String   @id @default(cuid())
  offerId   String
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  offer CommercialOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt])
  @@index([action])
}
