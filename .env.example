# Skillary environment template — copy to .env.local; never commit real values.

# REQUIRED — PostgreSQL / Prisma
DATABASE_URL="postgresql://username:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:5432/postgres"

# REQUIRED — Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# REQUIRED FOR PERSISTENT UPLOADS — server only, never NEXT_PUBLIC
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Public: thumbnails, images. Private: resources.

# EMAIL — disabled/fails soft when key is absent
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Skillary <hello@skillary.id>"
LEAD_NOTIFICATION_TO=""

# WEBINARS — disabled/fails soft when absent
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_WEBHOOK_SECRET_TOKEN=""

# DISTRIBUTED RATE LIMITING — required in production
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# PAYMENT — keep false until activation gate is approved
PAYMENTS_ENABLED="false"
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# CANONICAL OFFER READER — keep false until B1 migration and QA pass
CANONICAL_OFFERS_ENABLED="false"

# OBSERVABILITY / ANALYTICS — all optional and fail closed
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA4_ID=""

# SCHEDULED JOB AND DEEP HEALTH AUTH
CRON_SECRET=""
HEALTHCHECK_SECRET=""
